# Copy to .env.local (development) or set in your host's secret manager (production).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin of the app, e.g. https://reconcilex.example.com
BETTER_AUTH_URL=http://127.0.0.1:3001
# Better Auth telemetry is disabled; keep it that way.
BETTER_AUTH_TELEMETRY=0
# Optional: SQLite file location (default ./data/reconcilex.db)
# RECONCILEX_DB_PATH=
